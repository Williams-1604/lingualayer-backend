# LinguaLayer API
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
# STELLAR_NETWORK=testnet
# SOROBAN_RPC_URL=
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
DATASET_REGISTRY_CONTRACT_ID=
LICENSE_CONTRACT_ID=

# SEP-0010 Web Authentication (GET /auth/challenge, POST /auth/token)
STELLAR_NETWORK=testnet
SEP10_SERVER_SECRET=
SEP10_HOME_DOMAIN=lingualayer.app
SEP10_WEB_AUTH_DOMAIN=
SEP10_CHALLENGE_TIMEOUT_SECONDS=300
JWT_SECRET=
JWT_TTL_SECONDS=3600

# DataCommission event indexer (GET /commissions, GET /commissions/:id)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
DATA_COMMISSION_CONTRACT_ID=
COMMISSION_INDEXER_POLL_INTERVAL_MS=5000

# SEP-0010 Web Authentication (GET /auth/challenge, POST /auth/token)
STELLAR_NETWORK=testnet
SEP10_SERVER_SECRET=
SEP10_HOME_DOMAIN=lingualayer.app
SEP10_WEB_AUTH_DOMAIN=
SEP10_CHALLENGE_TIMEOUT_SECONDS=300
JWT_SECRET=
JWT_TTL_SECONDS=3600

# DataCommission event indexer (GET /commissions, GET /commissions/:id)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
DATA_COMMISSION_CONTRACT_ID=
COMMISSION_INDEXER_POLL_INTERVAL_MS=5000

